{
  "$schema": "https://railway.app/railway.schema.json",
  "build": {
    "builder": "NIXPACKS",
    "buildCommand": "cd p2p && npm ci --only=production"
  },
  "deploy": {
    "startCommand": "cd p2p && node server.js",
    "healthcheckPath": "/api/stats",
    "restartPolicyType": "ON_FAILURE"
  }
}
